{
  "name": "boxcode-promo",
  "version": "0.1.0",
  "private": true,
  "description": "BoxCode 宣传片（Remotion）",
  "scripts": {
    "studio": "npm run music && remotion studio src/index.ts",
    "music": "node music/compose.mjs",
    "render": "npm run music && remotion render src/index.ts Promo ../site/media/boxcode-promo.mp4 --is-production=false",
    "poster": "remotion still src/index.ts Promo ../site/media/boxcode-promo-poster.png --frame=1410",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
